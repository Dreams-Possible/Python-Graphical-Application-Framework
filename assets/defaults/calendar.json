{
  "schema_version": 4,
  "values": {
    "holiday_url": "https://raw.githubusercontent.com/NateScarlet/holiday-cn/master/{year}.json",
    "timeout_seconds": 10,
    "international_url": "https://date.nager.at/api/v3/PublicHolidays/{year}/{country}",
    "history_enabled": true,
    "history_url": "https://{language}.wikipedia.org/api/rest_v1/feed/onthisday/selected/{month}/{day}",
    "history_limit": 10,
    "history_preload": true,
    "history_preload_minutes": 60,
    "history_preload_before": 1,
    "history_preload_after": 2
  }
}
